{
  "name": "mumu",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "mumu",
  "engines": {
    "node": ">=22.15"
  },
  "workspaces": [
    "plugins/**",
    "apps/*"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "check:web": "npm --workspace apps/web run check",
    "test:web": "npm --workspace apps/web run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
