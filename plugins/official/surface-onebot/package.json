{
  "name": "@mumu/surface-onebot",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "description": "QQ 表现端：OneBot v11 正向 WebSocket 连 NapCat，私聊 / 群聊 / 通知进感知，发言按打字节奏分条发出，QQ 的其余能力作为动作交给导演",
  "mumu": {
    "enabled": true,
    "order": 10,
    "description": "QQ 表现端（OneBot v11 / NapCat）：私聊 → message，群聊 → group.message（@ 或叫名字 → message + urgent），戳她 / 撤回 / 进出群 / 加好友 → qq.*；每条发出成功才回执；引用与 @；动作 qq.send / qq.manage / qq.query / qq.call；所有写操作过出口节流（全局一双手、打字时间、每分钟上限）；/onebot 看状态",
    "defaults": {
      "url": "ws://127.0.0.1:3001",
      "token": "",
      "tokenRef": "onebot",
      "reconnectMs": 5000,
      "callTimeoutMs": 10000,
      "names": [
        "沐沐"
      ],
      "privateUrgent": true,
      "inputStatus": true,
      "voiceToText": true,
      "keepMessages": 80,
      "inline": true,
      "actions": true,
      "saveMedia": true,
      "maxMediaBytes": 8000000,
      "mediaDir": "data/media",
      "throttle": {
        "minGapMs": 1500,
        "maxGapMs": 4000,
        "typingBaseMs": 1500,
        "msPerChar": 350,
        "maxTypingMs": 15000,
        "jitter": 0.25,
        "perMinute": 8,
        "inputStatusMinMs": 1500
      },
      "split": {
        "minChars": 6,
        "stripTrailingPeriod": true
      },
      "notices": {
        "poke": true,
        "recall": true,
        "join": true,
        "ban": true,
        "request": true
      },
      "query": {
        "resultChars": 1200,
        "denyCall": [
          "bot_exit",
          "set_restart"
        ]
      },
      "vision": {
        "enabled": true,
        "role": "vision.read",
        "shrinkTo": 512,
        "maxBytes": 400000,
        "timeoutMs": 30000,
        "cache": 2000,
        "cacheFile": "data/vision-cache.json",
        "perMinute": 10,
        "staleSec": 45,
        "gifFrames": 4
      },
      "images": {
        "inline": {
          "count": 3,
          "withinMin": 15,
          "maxSide": 1024,
          "quality": 80,
          "stickers": true,
          "maxBytes": 2000000
        }
      },
      "stickers": true
    },
    "title": "QQ（NapCat）",
    "ui": {
      "url": {
        "label": "NapCat 地址",
        "hint": "NapCat 的 WebSocket 服务端，含端口，如 ws://127.0.0.1:3001；改完自动重连"
      },
      "token": {
        "label": "token",
        "hint": "NapCat WebSocket 服务端设的 token；没设就留空。也可以不填这里，改用 /secret set onebot <token>",
        "widget": "password",
        "secret": true
      },
      "tokenRef": {
        "label": "token 在密钥库里的名字",
        "hint": "上面 token 留空时，按这个名字去密钥库取"
      },
      "reconnectMs": {
        "label": "断线重连间隔（毫秒）",
        "widget": "slider",
        "min": 1000,
        "max": 60000,
        "step": 1000
      },
      "callTimeoutMs": {
        "label": "接口超时（毫秒）",
        "widget": "slider",
        "min": 2000,
        "max": 60000,
        "step": 1000
      },
      "names": {
        "label": "她的名字",
        "hint": "群里有人说到这些名字 = 在叫她（必答）"
      },
      "privateUrgent": {
        "label": "私聊新消息打断她",
        "hint": "对方又发一条时，她正在打的字作废、先听对方的"
      },
      "inputStatus": {
        "label": "私聊显示「正在输入」"
      },
      "voiceToText": {
        "label": "语音转文字",
        "hint": "收到语音时让 NapCat 转成文字给她看"
      },
      "keepMessages": {
        "label": "每个会话记住几条",
        "hint": "用于引用回复、撤回时说出原文、@ 人",
        "widget": "slider",
        "min": 20,
        "max": 300,
        "step": 10
      },
      "inline": {
        "label": "教她引用和 @",
        "hint": "发言里可写 <|quote|> 引用对方、<|at:名字|> @ 人"
      },
      "actions": {
        "label": "把 QQ 能力交给导演",
        "hint": "qq.send / qq.manage / qq.query / qq.call 四个动作"
      },
      "mediaDir": {
        "label": "图片目录",
        "hint": "别的动作（截图、找图）产出的图片放在哪"
      },
      "throttle": {
        "label": "出口节流（人手速度）"
      },
      "throttle.minGapMs": {
        "label": "两次操作最短间隔（毫秒）",
        "widget": "slider",
        "min": 100,
        "max": 5000,
        "step": 50
      },
      "throttle.maxGapMs": {
        "label": "两次操作最长间隔（毫秒）",
        "hint": "实际间隔在最短与最长之间随机",
        "widget": "slider",
        "min": 100,
        "max": 8000,
        "step": 50
      },
      "throttle.typingBaseMs": {
        "label": "打字基础时间（毫秒）",
        "widget": "slider",
        "min": 0,
        "max": 3000,
        "step": 50
      },
      "throttle.msPerChar": {
        "label": "每字毫秒",
        "hint": "发文字的打字时间 = 基础时间 + 字数 × 这个",
        "widget": "slider",
        "min": 20,
        "max": 600,
        "step": 10
      },
      "throttle.maxTypingMs": {
        "label": "打字时间上限（毫秒）",
        "widget": "slider",
        "min": 1000,
        "max": 20000,
        "step": 500
      },
      "throttle.jitter": {
        "label": "打字时间抖动",
        "hint": "0.25 = 上下浮动 25%",
        "widget": "slider",
        "min": 0,
        "max": 0.6,
        "step": 0.05
      },
      "throttle.perMinute": {
        "label": "每分钟最多操作",
        "hint": "超了排队，不丢",
        "widget": "slider",
        "min": 3,
        "max": 120,
        "step": 1
      },
      "throttle.inputStatusMinMs": {
        "label": "打字多久才显示「正在输入」（毫秒）",
        "widget": "slider",
        "min": 0,
        "max": 6000,
        "step": 100
      },
      "split": {
        "label": "分条"
      },
      "split.minChars": {
        "label": "句末切条至少几个字",
        "hint": "太短的句子并进下一条，免得太碎",
        "widget": "slider",
        "min": 1,
        "max": 30,
        "step": 1
      },
      "split.stripTrailingPeriod": {
        "label": "去掉句尾句号"
      },
      "notices": {
        "label": "要告诉她的 QQ 通知"
      },
      "notices.poke": {
        "label": "有人戳她"
      },
      "notices.recall": {
        "label": "有人撤回"
      },
      "notices.join": {
        "label": "有人进群 / 退群"
      },
      "notices.ban": {
        "label": "她被禁言 / 踢出"
      },
      "notices.request": {
        "label": "加好友 / 拉她进群"
      },
      "query": {
        "label": "查询与通用调用"
      },
      "query.resultChars": {
        "label": "查询结果最多几个字",
        "widget": "slider",
        "min": 200,
        "max": 5000,
        "step": 100
      },
      "query.denyCall": {
        "label": "qq.call 不让调的接口",
        "hint": "默认禁掉会让她自己掉线的退出、重启"
      },
      "vision": {
        "label": "看图"
      },
      "vision.enabled": {
        "label": "看图开关"
      },
      "vision.role": {
        "label": "看图用的模型角色",
        "hint": "在 provider-openai 的 roles 里绑定"
      },
      "vision.shrinkTo": {
        "label": "送模型前缩到多少像素（长边）",
        "widget": "slider",
        "min": 128,
        "max": 2048,
        "step": 64
      },
      "vision.maxBytes": {
        "label": "图片上限（字节）",
        "hint": "缩完还超过就不看"
      },
      "vision.timeoutMs": {
        "label": "看一张图最多等（毫秒）",
        "widget": "slider",
        "min": 5000,
        "max": 120000,
        "step": 1000
      },
      "stickers": {
        "label": "表情包",
        "hint": "收群友发的表情包、按 <|sticker:描述|> 发；库、审核、联网找图、发的频率在「表情包」插件里设"
      },
      "images.inline": {
        "label": "原图进上下文",
        "hint": "聊天里最近几张图以原图给发言者和大脑看（快回不带），看图描述照样生成给记忆 / 搜索 / 日志用；更早的、超额的仍用文字描述"
      },
      "images.inline.count": {
        "label": "每个会话最近几张带原图",
        "hint": "0 = 关掉，全用文字描述",
        "widget": "slider",
        "min": 0,
        "max": 10,
        "step": 1
      },
      "images.inline.withinMin": {
        "label": "多少分钟内的图",
        "widget": "slider",
        "min": 1,
        "max": 120,
        "step": 1
      },
      "images.inline.maxSide": {
        "label": "原图缩到多少像素（长边）",
        "hint": "只影响之后收到的图；1024 的图 DeepSeek 约 500 token、本地 qwen 约 770 token 一张",
        "widget": "slider",
        "min": 256,
        "max": 2048,
        "step": 64
      },
      "images.inline.quality": {
        "label": "JPEG 质量",
        "widget": "slider",
        "min": 30,
        "max": 100,
        "step": 5
      },
      "images.inline.stickers": {
        "label": "表情包也带原图",
        "hint": "表情包常是语气的一部分；关掉就只用描述"
      },
      "images.inline.maxBytes": {
        "label": "一次提示词里原图加起来的上限（字节）",
        "hint": "超了从最旧的那张开始退回文字描述"
      },
      "vision.cache": {
        "label": "记住几张图的描述",
        "hint": "按图片内容记，同一张图不再问模型（表情包另由表情包库记）",
        "widget": "slider",
        "min": 0,
        "max": 10000,
        "step": 100
      },
      "vision.cacheFile": {
        "label": "看图结果存在哪",
        "hint": "重启后也认得看过的图；留空 = 只记在内存里"
      },
      "vision.perMinute": {
        "label": "每个会话每分钟最多看几张",
        "hint": "超了写成「[图片：没顾上看]」；看过的图不算",
        "widget": "slider",
        "min": 1,
        "max": 60,
        "step": 1
      },
      "vision.staleSec": {
        "label": "排队超过几秒的图不看了",
        "hint": "群里刷图时后面的图等太久，对话早过去了",
        "widget": "slider",
        "min": 10,
        "max": 300,
        "step": 5
      },
      "vision.gifFrames": {
        "label": "动图抽几帧拼起来看",
        "hint": "Windows 上有效；macOS 只看第一帧",
        "widget": "slider",
        "min": 1,
        "max": 8,
        "step": 1
      },
      "saveMedia": {
        "label": "图片存一份给网页看",
        "hint": "收到的图片 / 表情包、她发的表情包存进图片目录，网页对话里才显示得出图"
      },
      "maxMediaBytes": {
        "label": "单张图片上限（字节）"
      }
    }
  }
}
