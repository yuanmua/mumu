{
  "name": "@mumu/life",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "description": "生活状态：她此刻在干嘛（吃饭、犯困、刷视频、打游戏、睡觉……），按作息到点换、她自己选、聊天里顺口改、网页上能设",
  "mumu": {
    "title": "在干嘛",
    "enabled": true,
    "order": 0,
    "description": "生活状态：作息时段 × 权重抽签（种子进日志）+ 到点让她自己选一件、补一句细节（本地模型，失败退回抽签）；大脑 life.set 动作改、网页面板「在干嘛」/ /life 设；发言者段落「你此刻在干嘛」、beat/gather「你在干嘛」；水线 life/now 报忙不忙系数；睡着时不主动找话；日志 life.changed",
    "defaults": {
      "timeZone": "Asia/Shanghai",
      "weekendDays": [0, 6],
      "role": "mind.decide",
      "choose": true,
      "chooseTimeoutSec": 30,
      "tickSec": 30,
      "quietSec": 600,
      "activities": [
        { "name": "睡觉", "minutes": [90, 300], "busy": 0.5, "asleep": true, "repeat": true, "details": ["睡着了", "抱着被子睡得正香", "睡得迷迷糊糊", "梦到在空间站里飘"], "words": ["睡觉", "睡了", "躺下"] },
        { "name": "犯困", "minutes": [20, 50], "busy": 0.9, "details": ["困得睁不开眼", "赖在床上不想动", "刚醒还懵着", "一直打哈欠"], "words": ["困", "赖床", "刚醒"] },
        { "name": "吃饭", "minutes": [25, 50], "busy": 0.7, "gapMin": 150, "details": ["在吃火锅", "叫了麻辣烫外卖", "煮了碗泡面加蛋", "吃黄焖鸡米饭", "下楼吃了碗牛肉面", "点了披萨", "在吃家里做的饭"], "words": ["吃饭", "外卖", "火锅", "午饭", "晚饭", "早饭", "麻辣烫", "泡面", "米饭"] },
        { "name": "吃零食", "minutes": [10, 25], "busy": 1, "gapMin": 120, "notAfter": ["吃饭"], "details": ["在吃布丁", "啃巧克力", "喝奶茶", "偷吃冰淇淋", "拆了包小蛋糕"], "words": ["零食", "奶茶", "布丁", "蛋糕", "冰淇淋", "巧克力", "甜品"] },
        { "name": "刷视频", "minutes": [20, 60], "busy": 1, "details": ["在刷短视频", "刷到一只超胖的猫", "在看火箭发射回放", "刷到个冷知识视频", "在b站看鬼畜"], "words": ["视频", "刷手机", "b站", "抖音"] },
        { "name": "打游戏", "minutes": [30, 90], "busy": 0.6, "details": ["在打游戏，卡在第三关", "在打排位", "在玩种田游戏", "在肝活动", "跟网友开黑"], "words": ["游戏", "排位", "开黑", "上分"] },
        { "name": "听歌", "minutes": [20, 60], "busy": 1, "details": ["戴着耳机听歌", "单曲循环一首歌", "在翻新歌单", "边听歌边发呆"], "words": ["听歌", "歌单", "耳机", "音乐"] },
        { "name": "写作业", "minutes": [40, 90], "busy": 0.8, "gapMin": 60, "details": ["在写数学作业", "在背英语单词", "对着物理题发呆", "在赶作业"], "words": ["作业", "学习", "复习", "背单词", "刷题"] },
        { "name": "看书", "minutes": [30, 60], "busy": 0.9, "details": ["在看一本科幻小说", "翻航天杂志", "在看漫画"], "words": ["看书", "小说", "漫画", "杂志"] },
        { "name": "发呆", "minutes": [10, 30], "busy": 1, "details": ["趴在窗边发呆", "躺着看天花板", "在想晚上吃什么", "盯着天上的云"], "words": ["发呆", "无聊"] },
        { "name": "出门", "minutes": [40, 120], "busy": 0.6, "gapMin": 180, "details": ["出门买奶茶", "下楼取快递", "在便利店挑冰淇淋", "出去逛街", "去楼下散步"], "words": ["出门", "逛街", "快递", "散步", "便利店"] },
        { "name": "洗澡", "minutes": [20, 40], "busy": 0.5, "gapMin": 600, "notAfter": ["吃饭"], "details": ["在洗澡", "洗完澡在吹头发"], "words": ["洗澡", "吹头发"] }
      ],
      "rhythm": [
        { "from": "00:00", "label": "深夜", "pick": { "刷视频": 3, "听歌": 3, "打游戏": 2, "吃零食": 1, "发呆": 1, "犯困": 1 }, "weekend": { "打游戏": 3, "刷视频": 3, "听歌": 2, "吃零食": 1 } },
        { "from": "01:30", "label": "该睡了", "pick": { "睡觉": 3, "刷视频": 2, "听歌": 1 }, "weekend": { "睡觉": 1, "刷视频": 2, "打游戏": 2, "听歌": 1 } },
        { "from": "03:00", "label": "睡着的点", "pick": { "睡觉": 1 } },
        { "from": "09:30", "label": "起床", "pick": { "犯困": 3, "刷视频": 1, "发呆": 1 }, "weekend": { "睡觉": 5, "犯困": 1 } },
        { "from": "11:30", "label": "午饭", "pick": { "吃饭": 6, "刷视频": 1 } },
        { "from": "13:00", "label": "午后", "pick": { "犯困": 2, "刷视频": 2, "写作业": 3, "听歌": 1, "看书": 1 }, "weekend": { "打游戏": 3, "出门": 3, "刷视频": 2, "看书": 1, "犯困": 1 } },
        { "from": "15:30", "label": "下午", "pick": { "写作业": 3, "吃零食": 2, "刷视频": 2, "出门": 1, "听歌": 1, "发呆": 1 }, "weekend": { "出门": 3, "打游戏": 2, "吃零食": 2, "刷视频": 2 } },
        { "from": "17:30", "label": "晚饭", "pick": { "吃饭": 6, "刷视频": 1 } },
        { "from": "19:00", "label": "晚上", "pick": { "打游戏": 3, "刷视频": 3, "写作业": 2, "听歌": 2, "洗澡": 1, "看书": 1 }, "weekend": { "打游戏": 4, "刷视频": 3, "听歌": 2, "洗澡": 1 } },
        { "from": "22:30", "label": "夜里", "pick": { "听歌": 3, "刷视频": 3, "打游戏": 2, "吃零食": 1, "洗澡": 2, "发呆": 1 } }
      ]
    },
    "ui": {
      "timeZone": { "label": "时区", "hint": "作息按这个时区的钟走（和 clock 插件一致）" },
      "weekendDays": { "label": "周末是星期几", "hint": "0 = 周日，6 = 周六" },
      "role": { "label": "她自己选用的模型角色", "hint": "在 provider-openai 的 roles 里绑定；默认用大脑的 mind.decide（本地模型，便宜）" },
      "choose": { "label": "到点让她自己选", "hint": "关掉就纯按权重抽签" },
      "chooseTimeoutSec": { "label": "她选多久没选出来就退回抽签（秒）" },
      "tickSec": { "hidden": true },
      "quietSec": { "label": "睡着时：多少秒内有人叫过她才开口", "hint": "她自己想找话（timer）会被拦下；被 @、私聊找她照常回。0 = 不拦" },
      "activities": { "label": "活动表", "widget": "json", "hint": "name 名字；details 细节候选；minutes 一次多久 [最短, 最长]；busy 忙不忙系数（给接话意愿乘，1 = 不忙）；asleep 睡着了；repeat 可以连着做；gapMin 做完多少分钟内不再做；notAfter 紧跟在哪些事后面不做；words 认「在吃火锅」这种说法的词" },
      "rhythm": { "label": "作息表", "widget": "json", "hint": "from 'HH:MM' 起到下一个时段为止；pick 活动 → 权重；weekend 周末换这一组" }
    }
  }
}
