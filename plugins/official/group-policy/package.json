        "widget": "slider",
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "followWindowSec": {
        "label": "接话：她说完多少秒内"
      },
      "followMaxBetween": {
        "label": "接话：中间最多隔几句"
